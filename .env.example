# Copy to .env.local (git ignores it) to try a switch while developing. Production values live only in the
# Vercel project's environment variables. Never commit real values. See docs/adr/0003-accounts-and-sync.md.

# "on" shows ··· → Account. Unset (the default) means off.
# VITE_TALLY_ACCOUNTS=on

# For later, once a provider is chosen. All public once built in; no flow needs a client secret.
# VITE_GOOGLE_CLIENT_ID=
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
